# Docker Compose PostgreSQL settings
ODAS_POSTGRES_DB=odas
ODAS_POSTGRES_USER=odas
ODAS_POSTGRES_PASSWORD=odas
ODAS_POSTGRES_PORT=5432
ODAS_POSTGRES_TZ=UTC

# Spring Boot datasource settings.
# Defaults in boot/src/main/resources/application.yml should match these values.
ODAS_DB_URL=jdbc:postgresql://localhost:5432/odas
ODAS_DB_USERNAME=odas
ODAS_DB_PASSWORD=odas
